<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

     <!-- Brand-led landing screen; scrolling also supports small landscape windows. -->
     <LinearLayout
        android:id="@+id/folder_select_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_background"
        android:orientation="vertical"
        android:accessibilityPaneTitle="@string/home_title">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="@dimen/home_padding">

                <ImageView
                    android:layout_width="@dimen/home_logo_size"
                    android:layout_height="@dimen/home_logo_size"
                    android:src="@drawable/ic_launcher_foreground"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_title"
                    android:textColor="#66DFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.18" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/home_title_size"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="32sp"
                    android:autoSizeStepGranularity="1sp" />

                <Button
                    android:id="@+id/btn_select_folder"
                    android:layout_width="wrap_content"
                    android:minWidth="280dp"
                    android:maxWidth="280dp"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingVertical="8dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/home_primary_button"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="@string/home_select"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_controls_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/tv_controls_hint"
                    android:textColor="#9FAECD"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
     </LinearLayout>

     <!-- Player screen -->
     <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

         <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:show_buffering="never" />

         <View
            android:id="@+id/touch_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

         <!-- Navigation, filename and transport stay in separate rows at every screen width. -->
         <LinearLayout
            android:id="@+id/pause_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#D9101723"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

             <LinearLayout
                android:id="@+id/player_navigation_controls"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                 <ImageButton
                    android:id="@+id/btn_overlay_home"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/return_to_home"
                    android:tooltipText="@string/return_to_home"
                    android:src="@drawable/ic_home"
                    android:nextFocusLeft="@id/btn_overlay_info"
                    android:nextFocusRight="@id/btn_overlay_select_folder"
                    android:nextFocusUp="@id/btn_overlay_play_pause"
                    android:nextFocusDown="@id/btn_overlay_play_pause"
                    android:nextFocusForward="@id/btn_overlay_select_folder" />
                 <ImageButton
                    android:id="@+id/btn_overlay_select_folder"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/select_folder"
                    android:tooltipText="@string/select_folder"
                    android:src="@drawable/ic_folder_open"
                    android:nextFocusLeft="@id/btn_overlay_home"
                    android:nextFocusRight="@id/btn_overlay_info"
                    android:nextFocusUp="@id/btn_overlay_play_pause"
                    android:nextFocusDown="@id/btn_overlay_play_pause"
                    android:nextFocusForward="@id/btn_overlay_info" />
                 <ImageButton
                    android:id="@+id/btn_overlay_info"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/info"
                    android:tooltipText="@string/info"
                    android:src="@drawable/ic_info"
                    android:nextFocusLeft="@id/btn_overlay_select_folder"
                    android:nextFocusRight="@id/btn_overlay_home"
                    android:nextFocusUp="@id/btn_overlay_play_pause"
                    android:nextFocusDown="@id/btn_overlay_play_pause"
                    android:nextFocusForward="@id/btn_overlay_previous" />
             </LinearLayout>

             <TextView
                android:id="@+id/overlay_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:paddingHorizontal="8dp"
                android:gravity="center"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

             <TextView
                android:id="@+id/playback_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

             <LinearLayout
                android:id="@+id/player_transport_controls"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center">
                 <ImageButton
                    android:id="@+id/btn_overlay_previous"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/previous_file"
                    android:tooltipText="@string/previous_file"
                    android:src="@drawable/ic_previous"
                    android:nextFocusLeft="@id/btn_overlay_next"
                    android:nextFocusRight="@id/btn_overlay_rewind"
                    android:nextFocusUp="@id/btn_overlay_info"
                    android:nextFocusDown="@id/btn_overlay_info"
                    android:nextFocusForward="@id/btn_overlay_rewind" />
                 <ImageButton
                    android:id="@+id/btn_overlay_rewind"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/rewind_ten_seconds"
                    android:tooltipText="@string/rewind_ten_seconds"
                    android:src="@drawable/ic_rewind_10"
                    android:nextFocusLeft="@id/btn_overlay_previous"
                    android:nextFocusRight="@id/btn_overlay_play_pause"
                    android:nextFocusUp="@id/btn_overlay_info"
                    android:nextFocusDown="@id/btn_overlay_info"
                    android:nextFocusForward="@id/btn_overlay_play_pause" />
                 <ImageButton
                    android:id="@+id/btn_overlay_play_pause"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/resume_playback"
                    android:tooltipText="@string/resume_playback"
                    android:src="@drawable/ic_play"
                    android:nextFocusLeft="@id/btn_overlay_rewind"
                    android:nextFocusRight="@id/btn_overlay_forward"
                    android:nextFocusUp="@id/btn_overlay_info"
                    android:nextFocusDown="@id/btn_overlay_info"
                    android:nextFocusForward="@id/btn_overlay_forward" />
                 <ImageButton
                    android:id="@+id/btn_overlay_forward"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/forward_ten_seconds"
                    android:tooltipText="@string/forward_ten_seconds"
                    android:src="@drawable/ic_forward_10"
                    android:nextFocusLeft="@id/btn_overlay_play_pause"
                    android:nextFocusRight="@id/btn_overlay_next"
                    android:nextFocusUp="@id/btn_overlay_info"
                    android:nextFocusDown="@id/btn_overlay_info"
                    android:nextFocusForward="@id/btn_overlay_next" />
                 <ImageButton
                    android:id="@+id/btn_overlay_next"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/next_file"
                    android:tooltipText="@string/next_file"
                    android:src="@drawable/ic_next"
                    android:nextFocusLeft="@id/btn_overlay_forward"
                    android:nextFocusRight="@id/btn_overlay_previous"
                    android:nextFocusUp="@id/btn_overlay_info"
                    android:nextFocusDown="@id/btn_overlay_info"
                    android:nextFocusForward="@id/btn_overlay_home" />
             </LinearLayout>
         </LinearLayout>

         <!-- Portrait video info (centered in bottom dark area) -->
         <TextView
            android:id="@+id/portrait_video_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="120dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textColor="#B0FFFFFF"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone" />

     </FrameLayout>

</FrameLayout>
