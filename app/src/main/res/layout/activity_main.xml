<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

     <!-- Brand-led landing screen; scrolling also supports small landscape windows. -->
     <LinearLayout
        android:id="@+id/folder_select_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_background"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="@dimen/home_padding">

                <ImageView
                    android:layout_width="@dimen/home_logo_size"
                    android:layout_height="@dimen/home_logo_size"
                    android:src="@drawable/ic_launcher_foreground"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_eyebrow"
                    android:textColor="#66DFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.18" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/home_title_size"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="20sp"
                    android:autoSizeMaxTextSize="32sp"
                    android:autoSizeStepGranularity="1sp" />

                <Button
                    android:id="@+id/btn_select_folder"
                    android:layout_width="280dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/home_primary_button"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="@string/home_select"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:nextFocusDown="@id/btn_exit" />

                <Button
                    android:id="@+id/btn_exit"
                    android:layout_width="280dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/home_secondary_button"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="@string/exit_app"
                    android:textAllCaps="false"
                    android:textColor="#CED4ED"
                    android:nextFocusUp="@id/btn_select_folder" />

                <TextView
                    android:id="@+id/tv_controls_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/tv_controls_hint"
                    android:textColor="#9FAECD"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
     </LinearLayout>

     <!-- Player screen -->
     <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

         <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:show_buffering="when_playing" />

         <View
            android:id="@+id/touch_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

         <!-- Pause toolbar -->
         <LinearLayout
            android:id="@+id/pause_overlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:background="#B0000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

             <TextView
                android:id="@+id/overlay_filename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

             <ImageButton
                android:id="@+id/btn_overlay_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/player_button_background"
                android:contentDescription="@string/resume_playback"
                android:nextFocusLeft="@id/btn_overlay_exit"
                android:nextFocusRight="@id/btn_overlay_info"
                android:src="@drawable/ic_play"
                android:tooltipText="@string/resume_playback" />

             <ImageButton
                android:id="@+id/btn_overlay_info"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/player_button_background"
                android:contentDescription="@string/info"
                android:nextFocusLeft="@id/btn_overlay_play_pause"
                android:nextFocusRight="@id/btn_overlay_select_folder"
                android:src="@drawable/ic_info"
                android:tooltipText="@string/info" />

             <ImageButton
                android:id="@+id/btn_overlay_select_folder"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/player_button_background"
                android:contentDescription="@string/select_folder"
                android:nextFocusLeft="@id/btn_overlay_info"
                android:nextFocusRight="@id/btn_overlay_exit"
                android:src="@drawable/ic_folder_open"
                android:tooltipText="@string/select_folder" />

             <ImageButton
                android:id="@+id/btn_overlay_exit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/player_button_background"
                android:contentDescription="@string/exit_app"
                android:nextFocusLeft="@id/btn_overlay_select_folder"
                android:nextFocusRight="@id/btn_overlay_play_pause"
                android:src="@drawable/ic_close"
                android:tooltipText="@string/exit_app" />
         </LinearLayout>

         <!-- Portrait video info (centered in bottom dark area) -->
         <TextView
            android:id="@+id/portrait_video_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="120dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textColor="#B0FFFFFF"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone" />

     </FrameLayout>

</FrameLayout>
