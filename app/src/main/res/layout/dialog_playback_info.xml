<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dlna_dialog_padding"
    android:background="@drawable/dlna_dialog_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Wrap short content; weight lets long content shrink while keeping OK visible. -->
    <ScrollView
        android:id="@+id/info_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/info_file_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/info_file_section" android:textColor="#66DFFF" android:textSize="18sp"
                android:accessibilityHeading="true" android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp" />
            <TextView
                android:id="@+id/info_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView android:id="@+id/info_file" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="#D8E3F2" android:textSize="14sp" android:lineSpacingExtra="4dp" />
            <TextView android:id="@+id/info_formats_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="@string/info_formats_section"
                android:textColor="#66DFFF" android:textSize="18sp" android:accessibilityHeading="true" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/info_formats" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#D8E3F2" android:textSize="14sp" android:lineSpacingExtra="4dp" />
            <TextView android:id="@+id/info_output_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/info_output_section" android:textColor="#66DFFF"
                android:textSize="18sp" android:accessibilityHeading="true" android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/info_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#D8E3F2"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/info_close"
        android:focusedByDefault="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="16dp"
        android:text="@android:string/ok"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:background="@drawable/home_secondary_button"
        android:backgroundTint="@null" />
</LinearLayout>
