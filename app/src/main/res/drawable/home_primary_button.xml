<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><corners android:radius="16dp" /><solid android:color="#6853BA" /><stroke android:width="2dp" android:color="#FFFFFF" /></shape></item>
    <item android:state_focused="true"><shape><corners android:radius="16dp" /><gradient android:startColor="#147D9D" android:endColor="#9759B1" android:angle="0" /><stroke android:width="3dp" android:color="#FFFFFF" /></shape></item>
    <item><shape><corners android:radius="16dp" /><gradient android:startColor="#166783" android:endColor="#784895" android:angle="0" /><stroke android:width="1dp" android:color="#769BCC" /></shape></item>
</selector>
