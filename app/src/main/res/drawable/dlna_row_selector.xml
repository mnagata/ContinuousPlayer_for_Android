<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#24546B" /><corners android:radius="12dp" /><stroke android:width="3dp" android:color="#8BECFF" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#263F59" /><corners android:radius="12dp" /><stroke android:width="3dp" android:color="#66DFFF" /></shape>
    </item>
    <item><shape><solid android:color="#00000000" /><corners android:radius="12dp" /></shape></item>
</selector>
